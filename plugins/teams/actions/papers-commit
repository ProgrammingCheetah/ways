#!/bin/sh
# zaf description: commit the release folder (ZAF_RELEASE_DIR), as the working copy holds it, in one commit on the version's integration branch (ZAF_BASE) and push the branch, printing `committed <id>`; a branch that already holds the folder as it stands is quiet; the working copy never moves and files outside the folder are never committed
# zaf 1: refused: ZAF_VERSION, ZAF_BASE or ZAF_RELEASE_DIR is unset or unusable, or the integration branch is not on the remote
# zaf 2: a backend failed (jj is missing or refused, the fetch failed, or the push failed)
# zaf mode: 750
# zaf group: release
# zaf vcs: jj
# changed: marked `vcs: jj`: a git project takes a `papers-commit.git` and never this file
branch=$ZAF_BASE
dir=$ZAF_RELEASE_DIR

if [ -z "$ZAF_ROOT" ] || [ -z "$ZAF_VERSION" ] || [ -z "$branch" ] || [ -z "$dir" ] || [ "$#" -ne 0 ]; then
    echo "usage: papers-commit, with ZAF_ROOT, ZAF_VERSION, ZAF_BASE and ZAF_RELEASE_DIR set" >&2
    exit 1
fi
case $branch in
    -* | *\"* | *\\*)
        echo "$branch is not a usable bookmark name" >&2
        exit 1
        ;;
esac

# The folder as a path under the project root: an absolute one inside it is cut down, a relative
# one loses its `./` and trailing slashes.
case $dir in
    "$ZAF_ROOT"/*) dir=${dir#"$ZAF_ROOT"/} ;;
    /*)
        echo "the release folder $dir is outside the project" >&2
        exit 1
        ;;
esac
while :; do
    case $dir in
        ./*) dir=${dir#./} ;;
        */) dir=${dir%/} ;;
        *) break ;;
    esac
done
case $dir in
    "" | . | .. | ../* | */.. | */../* | *\"* | *\\*)
        echo "the release folder $ZAF_RELEASE_DIR is not a folder inside the project" >&2
        exit 1
        ;;
esac
folder="root:\"$dir\""

jj_run() {
    jj --no-pager --color=never --ignore-working-copy -R "$ZAF_ROOT" "$@"
}

# One id for a revset (a commit id, or what the template in $2 names), or nothing. A jj that fails
# is its failure: each caller ends the run on it (`|| exit 2`, since an exit in here would end
# only the `$(...)`).
id_of() {
    ids=$(jj_run log --no-graph -r "$1" -T "${2:-commit_id} ++ \"\\n\"") || return 2
    printf '%s\n' "$ids" | awk 'NF { print; exit }'
}

# The remote the branch tracks; origin when it tracks none.
remote=origin
if ! tracked=$(jj_run bookmark list --tracked -T 'remote ++ "\n"' "exact:\"$branch\"" 2>/dev/null); then
    echo "jj could not list the bookmarks" >&2
    exit 2
fi
for name in $tracked; do
    if [ "$name" != "git" ]; then
        remote=$name
        break
    fi
done

# The one command that reads the working copy: it records the folder's files as they stand in the
# working copy's own commit, the commit the files already belong to, and moves nothing else.
if ! wc_commit=$(jj --no-pager --color=never -R "$ZAF_ROOT" log --no-graph -r '@' -T 'commit_id' 2>&1); then
    printf '%s\n' "$wc_commit" >&2
    exit 2
fi

if ! fetched=$(jj_run git fetch --remote "$remote" 2>&1); then
    printf '%s\n' "$fetched" >&2
    exit 2
fi

head=$(id_of "remote_bookmarks(exact:\"$branch\", exact:\"$remote\")") || exit 2
if [ -z "$head" ]; then
    echo "$branch is not on $remote; open it first" >&2
    exit 1
fi

# Nothing differs between the branch and the working copy in the folder: nothing to commit.
if ! changed=$(jj_run diff --summary --from "$head" --to "$wc_commit" -- "$folder" 2>&1); then
    printf '%s\n' "$changed" >&2
    exit 2
fi
if [ -z "$changed" ]; then
    exit 0
fi

# The local branch follows the remote's: a fetch moved it, unless it was never tracked.
local_head=$(id_of "bookmarks(exact:\"$branch\")") || exit 2
if [ -z "$local_head" ]; then
    if ! made=$(jj_run bookmark track "$branch" --remote "$remote" 2>&1); then
        printf '%s\n' "$made" >&2
        exit 2
    fi
elif [ "$local_head" != "$head" ]; then
    if ! moved=$(jj_run bookmark set "$branch" -r "$head" --allow-backwards 2>&1); then
        printf '%s\n' "$moved" >&2
        exit 2
    fi
fi

# A new commit beside the working copy (never edited into it), holding the folder as the working
# copy does: restoring the folder's paths takes in a file added, changed or removed there. It is
# named by its change id, which a rewrite keeps.
message="zaf: the papers of $ZAF_VERSION"
if ! created=$(jj_run new --no-edit -r "$head" -m "$message" 2>&1); then
    printf '%s\n' "$created" >&2
    exit 2
fi
new=$(id_of "latest(children(\"$head\") & mutable() & description(exact:\"$message\\n\"))" change_id) || exit 2
if [ -z "$new" ]; then
    echo "jj made no commit for the papers" >&2
    exit 2
fi

undo() {
    jj_run abandon "$new" >/dev/null 2>&1
}

if ! restored=$(jj_run restore --from "$wc_commit" --into "$new" -- "$folder" 2>&1); then
    printf '%s\n' "$restored" >&2
    undo
    exit 2
fi
if ! jj_run bookmark set "$branch" -r "$new" >/dev/null 2>&1; then
    echo "jj could not move $branch onto the papers" >&2
    undo
    exit 2
fi
# A plain push, never forced. A push that fails puts the local branch back and drops the commit,
# so a second run starts as this one did.
if ! pushed=$(jj_run git push --remote "$remote" --bookmark "exact:$branch" 2>&1); then
    printf '%s\n' "$pushed" >&2
    jj_run bookmark set "$branch" -r "$head" --allow-backwards >/dev/null 2>&1
    undo
    exit 2
fi
final=$(id_of "bookmarks(exact:\"$branch\")") || exit 2
echo "committed $final"
