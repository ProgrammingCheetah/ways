#!/bin/sh
# zaf description: commit the release folder (ZAF_RELEASE_DIR), as the working copy holds it, in one commit on the version's integration branch (ZAF_BASE) and push the branch, printing `committed <id>`; a branch that already holds the folder as it stands is quiet; the working copy never moves and files outside the folder are never committed
# zaf 1: refused: ZAF_VERSION, ZAF_BASE or ZAF_RELEASE_DIR is unset or unusable, or the integration branch is not on the remote
# zaf 2: a backend failed (git is missing or refused, the fetch failed, or the push failed)
# zaf mode: 750
# zaf group: release
# changed: the git version of `papers-commit`: a git project takes this file for that name; it builds the commit with `commit-tree` on a temporary index and pushes it forward, so the checkout, its branch and its index never move
branch=$ZAF_BASE
dir=$ZAF_RELEASE_DIR
remote=origin

if [ -z "$ZAF_ROOT" ] || [ -z "$ZAF_VERSION" ] || [ -z "$branch" ] || [ -z "$dir" ] || [ "$#" -ne 0 ]; then
    echo "usage: papers-commit, with ZAF_ROOT, ZAF_VERSION, ZAF_BASE and ZAF_RELEASE_DIR set" >&2
    exit 1
fi
case $branch in
    -* | *\"* | *\\*)
        echo "$branch is not a usable branch name" >&2
        exit 1
        ;;
esac

git_run() {
    git -C "$ZAF_ROOT" "$@"
}

if ! git_run check-ref-format "refs/heads/$branch" 2>/dev/null; then
    echo "$branch is not a usable branch name" >&2
    exit 1
fi

# The folder as a path under the project root: an absolute one inside it is cut down, a relative
# one loses its `./` and trailing slashes.
case $dir in
    "$ZAF_ROOT"/*) dir=${dir#"$ZAF_ROOT"/} ;;
    /*)
        echo "the release folder $dir is outside the project" >&2
        exit 1
        ;;
esac
while :; do
    case $dir in
        ./*) dir=${dir#./} ;;
        */) dir=${dir%/} ;;
        *) break ;;
    esac
done
case $dir in
    "" | . | .. | ../* | */.. | */../* | -* | *\"* | *\\*)
        echo "the release folder $ZAF_RELEASE_DIR is not a folder inside the project" >&2
        exit 1
        ;;
esac

# A fetch moves only the remote-tracking refs, so the checkout never moves.
if ! fetched=$(git_run fetch --quiet "$remote" 2>&1); then
    printf '%s\n' "$fetched" >&2
    exit 2
fi
if ! head=$(git_run rev-parse --verify --quiet "refs/remotes/$remote/$branch^{commit}"); then
    echo "$branch is not on $remote; open it first" >&2
    exit 1
fi

# The tree is built in a temporary index, never the real one: the branch's tree, the release
# folder taken out, then the folder as the working copy holds it put in. Nothing else of the
# working copy is read, so a file outside the folder never enters the commit.
scratch=$(mktemp -d) || exit 2
trap 'rm -rf "$scratch"' EXIT
GIT_INDEX_FILE=$scratch/index
export GIT_INDEX_FILE
if ! made=$(git_run read-tree "$head" 2>&1); then
    printf '%s\n' "$made" >&2
    exit 2
fi
if ! made=$(git_run rm -r --cached --quiet --ignore-unmatch -- "$dir" 2>&1); then
    printf '%s\n' "$made" >&2
    exit 2
fi
if [ -e "$ZAF_ROOT/$dir" ] || [ -L "$ZAF_ROOT/$dir" ]; then
    if ! made=$(git_run add -A -- "$dir" 2>&1); then
        printf '%s\n' "$made" >&2
        exit 2
    fi
fi
tree=$(git_run write-tree) || exit 2

# The branch already holds the folder as it stands: nothing to commit.
there=$(git_run rev-parse --verify "$head^{tree}") || exit 2
if [ "$tree" = "$there" ]; then
    exit 0
fi

# A machine with no git identity still commits, as zaf.
if ! git_run var GIT_COMMITTER_IDENT >/dev/null 2>&1; then
    GIT_COMMITTER_NAME=zaf
    GIT_COMMITTER_EMAIL=zaf@localhost
    export GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
fi
if ! git_run var GIT_AUTHOR_IDENT >/dev/null 2>&1; then
    GIT_AUTHOR_NAME=zaf
    GIT_AUTHOR_EMAIL=zaf@localhost
    export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL
fi
commit=$(git_run commit-tree "$tree" -p "$head" -m "zaf: the papers of $ZAF_VERSION") || exit 2

# A plain push of the commit, whose parent is the branch as fetched: a forward move, never forced.
# A branch that moved on the remote since the fetch is refused by git itself.
if ! pushed=$(git_run push --quiet "$remote" "$commit:refs/heads/$branch" 2>&1); then
    printf '%s\n' "$pushed" >&2
    exit 2
fi
echo "committed $commit"
