#!/bin/sh
# zaf description: wait for a pull request's checks to finish at its head, handing back the head commit; a failed check is named, with its failed log lines in the log; a pull request with no checks after the grace is passed
# zaf 1: refused: the arguments are not <pr> [--minutes <n>], or a check failed or was cancelled (each one named, last)
# zaf 2: a backend failed (gh is missing or refused, or printed no head commit)
# zaf 3: the checks were still running after the minutes given (--minutes, else CI_WAIT_MINUTES, else 20); the head commit is the last line
# zaf mode: 755
pr=$1

if [ -z "$ZAF_ROOT" ] || [ "$#" -lt 1 ]; then
    echo "usage: ci-wait <pr> [--minutes <n>], with ZAF_ROOT set" >&2
    exit 1
fi

# A pull request number is plain digits, with the `#` it is often written with.
pr=${pr#\#}
case $pr in
    "" | *[!0-9]*)
        echo "pull request $1 is not a number" >&2
        exit 1
        ;;
esac
shift

# The wait's length: --minutes, else CI_WAIT_MINUTES (a manifest's [env] can set it), else 20.
minutes=${CI_WAIT_MINUTES:-20}
case $minutes in
    "" | *[!0-9]*)
        echo "CI_WAIT_MINUTES is $minutes, not a whole number" >&2
        exit 1
        ;;
esac
while [ "$#" -gt 0 ]; do
    case $1 in
        --minutes)
            case $2 in
                "" | *[!0-9]*)
                    echo "--minutes needs a whole number" >&2
                    exit 1
                    ;;
            esac
            minutes=$2
            shift 2
            ;;
        *)
            echo "unknown option $1; the only one is --minutes <n>" >&2
            exit 1
            ;;
    esac
done

# Seconds between two reads of the checks, and how long a pull request may show none before it
# counts as having none: a workflow filtered by paths never reports any, and a fresh push takes a
# few seconds to register its runs.
interval=${CI_WAIT_INTERVAL:-20}
grace=${CI_WAIT_GRACE:-90}

# The forge repository the manifest names, the first manifest that names one, in the order zaf
# reads them. With none, gh works the repository out from the root's remotes, as it does by hand.
forge_repo() {
    for manifest in "$ZAF_ROOT/.zaf.toml" "$ZAF_ROOT/.zaf/config.toml" "$ZAF_ROOT/ZAF.toml"; do
        [ -f "$manifest" ] || continue
        found=$(awk '
            /^[ \t]*\[/ { in_forge = ($0 ~ /^[ \t]*\[forge\][ \t]*(#.*)?$/); next }
            in_forge && /^[ \t]*repo[ \t]*=/ {
                line = $0
                sub(/^[^=]*=[ \t]*"/, "", line)
                sub(/".*$/, "", line)
                print line
                exit
            }
        ' "$manifest")
        if [ -n "$found" ]; then
            echo "$found"
            return
        fi
    done
}

# gh reads a repository from the project root, never from a jj workspace.
cd "$ZAF_ROOT" || exit 2

repo=$(forge_repo)
if [ -n "$repo" ]; then
    set -- --repo "$repo"
else
    set --
fi

head_commit() {
    gh pr view "$pr" --json headRefOid --jq .headRefOid "$@"
}

errors=$(mktemp) || exit 2
trap 'rm -f "$errors"' EXIT

start=$(date +%s)
deadline=$((start + minutes * 60))
while :; do
    head=$(head_commit "$@") || exit 2
    if [ -z "$head" ]; then
        echo "gh printed no head commit for pull request #$pr" >&2
        exit 2
    fi

    # One line per check: its bucket (pass, fail, pending, skipping or cancel), name and link.
    # gh exits non-zero while a check is pending or failed, so its words decide, not its code.
    if checks=$(gh pr checks "$pr" --json bucket,name,link --jq '.[] | [.bucket, .name, .link] | @tsv' "$@" 2>"$errors"); then
        :
    elif grep -q 'no checks reported' "$errors"; then
        checks=
    elif [ -z "$checks" ]; then
        cat "$errors" >&2
        exit 2
    fi

    now=$(date +%s)
    if [ -z "$checks" ]; then
        if [ $((now - start)) -ge "$grace" ]; then
            echo "pull request #$pr reports no checks at $head"
            echo "$head"
            exit 0
        fi
    elif ! printf '%s\n' "$checks" | grep -q '^pending'; then
        # Settled. The head is read again: a push while the checks ran makes them another
        # commit's, and the wait starts over on the new head.
        again=$(head_commit "$@") || exit 2
        if [ "$again" = "$head" ]; then
            break
        fi
        echo "the head of pull request #$pr moved to $again; waiting on its checks" >&2
        continue
    fi

    if [ "$now" -ge "$deadline" ]; then
        printf '%s\n' "$checks" | awk -F '\t' '$1 == "pending" { print "still running: " $2 }'
        echo "$head"
        exit 3
    fi
    sleep "$interval"
done

failed=$(printf '%s\n' "$checks" | awk -F '\t' '$1 == "fail" || $1 == "cancel"')
if [ -z "$failed" ]; then
    echo "$head"
    exit 0
fi

# The failed lines of each failed job first, then the names: zaf shows the log's last lines on
# a failure, and those are the names.
printf '%s\n' "$failed" | while IFS="$(printf '\t')" read -r bucket name link; do
    job=$(printf '%s\n' "$link" | awk -F '/job/' 'NF > 1 { sub(/[^0-9].*$/, "", $2); print $2 }')
    if [ -n "$job" ]; then
        echo "--- failed log lines of $name (job $job)" >&2
        # Its own input, so it never reads the loop's; awk ends the last line, so the names start on one.
        gh run view --job "$job" --log-failed "$@" </dev/null 2>&1 | tail -n 80 | awk '{ print }' >&2
    fi
done
printf '%s\n' "$failed" | awk -F '\t' '{ print "failed: " $2 " (" $1 ") " $3 }'
exit 1
