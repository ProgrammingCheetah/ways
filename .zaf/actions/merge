#!/bin/sh
# zaf description: phase merge: land the task's slice with `slice-merge`, which a clean `zaf check pr` at the head of the pull request lets through
# zaf 1: refused: the argument is not <task>, the base conflicts, the base merge was pushed and needs a new `zaf check pr`, or the merge was refused
# zaf 2: a backend failed (jj, gh or the board failed, or `slice-merge` never ran)
# zaf mode: 755
# zaf target: task
# zaf kind: zaf
# zaf ends: merged

if [ "$#" -ne 1 ] || [ -z "$ZAF_ROOT" ]; then
    echo "usage: merge <task>, run by zaf with ZAF_ROOT set" >&2
    exit 1
fi

cd "$ZAF_ROOT" || exit 2

# `slice-merge` ends with 1 or 2; 125, a step that never ran, is a backend that failed.
zaf do slice-merge "$1"
status=$?
case $status in
    0 | 1 | 2) exit "$status" ;;
    *) exit 2 ;;
esac
