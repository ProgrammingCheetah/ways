#!/bin/sh
# zaf description: phase merge: land the task's slice with `slice-merge`, which a clean `zaf check pr` at the head of the pull request lets through; a base that moved on and merges into the slice cleanly asks for no new round, and a base that conflicts with the slice starts `fix`, whose programmer brings the base in with `sync-base`
# zaf 1: conflicted: the base conflicts with the slice in the paths the log names, and the slice is unchanged; `fix` runs next, and its programmer merges the base with `zaf do sync-base <task>` and resolves them
# zaf 2: a backend failed (jj, gh or the board failed, or `slice-merge` never ran)
# zaf 4: refused: the argument is not <task>, or a step refused (the forge refused the merge, or the head moved since the check); the merge runs again, and three at one head ask the Engineer
# zaf mode: 755
# zaf target: task
# zaf kind: zaf
# zaf ends: merged
# zaf on-fail: fix
# changed: a `slice-merge` refused because the workspace does not hold the pull request's head ends with exit 4 and those words, naming the head and the workspace's latest commit, last in the log

# The task as a bare number; zaf has already read it as one.
task=${1#\#}
if [ "$#" -ne 1 ] || [ -z "$ZAF_ROOT" ]; then
    echo "usage: merge <task>, run by zaf with ZAF_ROOT set" >&2
    exit 4
fi

cd "$ZAF_ROOT" || exit 2

# `slice-merge` ends with 1 or 2; 125, a step that never ran, is a backend that failed. Its 1 is
# two things, told apart here by what its log says, so the scheduler starts `fix` only for the
# one a programmer can answer: a conflict.
status=0
log=$(zaf do --more slice-merge "$1" 2>&1) || status=$?
printf '%s\n' "$log"

# `slice-merge` is refused when the workspace does not hold the pull request's head (the
# workspace is ahead of it, the head changed from outside, or it is not in the local store): a
# refusal that moves nothing, not a backend failure and not a conflict. Its words go last in the
# log, so the question after three of them names the head and the workspace's latest commit.
if [ "$status" -ne 0 ]; then
    held=$(printf '%s\n' "$log" | grep -m 1 "the workspace does not hold the pull request's head") && {
        printf '%s\n' "${held#*: }" >&2
        exit 4
    }
fi

case $status in
    0) exit 0 ;;
    1) ;;
    *) exit 2 ;;
esac

case $log in
    *"FAIL merge-base: exit 1,"*)
        # The paths `merge-base` named, on one line, last in the log: the run folder keeps the
        # last lines, and the fix brief quotes them.
        paths=$(printf '%s\n' "$log" | awk '
            / conflicts in:$/ { on = 1; list = ""; next }
            on && /^(OK|FAIL|NOT_RUN) / { on = 0 }
            on && NF { list = list (list == "" ? "" : ", ") $1 }
            END { print list }')
        echo "the base conflicts with the slice in: $paths" >&2
        echo "fix: bring the base in with zaf do sync-base $task, resolve those paths and commit the merge" >&2
        exit 1
        ;;
esac
exit 4
