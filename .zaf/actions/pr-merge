#!/bin/sh
# zaf description: merge a pull request with a merge commit, or squashed with --squash, only at the head commit named with --match-head-commit <sha> when one is given; one already merged is quiet; a merge refused for a moved base is retried up to three times, 15 seconds apart
# zaf 1: refused: the arguments are not <pr> [--squash] [--match-head-commit <sha>], the pull request is closed unmerged, or the forge refuses the merge (a head other than the named one is refused)
# zaf 2: a backend failed (the manifest names no forge, or the forge is unreachable or could not read the pull request)
# zaf mode: 750
# zaf group: team, release, merge
pr=$1

if [ -z "$ZAF_ROOT" ] || [ "$#" -lt 1 ]; then
    echo "usage: pr-merge <pr> [--squash] [--match-head-commit <sha>], with ZAF_ROOT set" >&2
    exit 1
fi

# A pull request number is plain digits, with the `#` it is often written with.
pr=${pr#\#}
case $pr in
    "" | *[!0-9]*)
        echo "pull request $1 is not a number" >&2
        exit 1
        ;;
esac

shift

# The strategy, and the head commit the merge is pinned to. With one, the forge refuses the merge
# when the pull request's head is any other commit, so a push after CI is never merged unchecked.
strategy=
pin=
while [ "$#" -gt 0 ]; do
    case $1 in
        --squash)
            strategy=--squash
            shift
            ;;
        --match-head-commit)
            if [ "$#" -lt 2 ]; then
                echo "--match-head-commit needs a commit" >&2
                exit 1
            fi
            case $2 in
                "" | *[!0-9a-f]*)
                    echo "$2 is not a commit id" >&2
                    exit 1
                    ;;
            esac
            pin=$2
            shift 2
            ;;
        *)
            echo "unknown option $1; the only ones are --squash and --match-head-commit <sha>" >&2
            exit 1
            ;;
    esac
done

set -- "$pr"
if [ -n "$strategy" ]; then
    set -- "$@" "$strategy"
fi
if [ -n "$pin" ]; then
    set -- "$@" --match-head-commit "$pin"
fi

# Up to three retries, the seconds between them the forge's own settling time.
retries=3
delay=15

# zaf reads the forge from the manifest at the project root; a slice's workspace has none.
cd "$ZAF_ROOT" || exit 2

# Parallel merges move the base under each other and leave the forge briefly unable to merge:
# zaf says `not mergeable yet` for those, and only those are worth waiting for; any other
# refusal is final. A pull request merged already is quiet.
tries=0
while :; do
    if output=$(zaf forge merge "$@" 2>&1); then
        exit 0
    else
        status=$?
    fi
    printf '%s\n' "$output" >&2
    if [ "$status" -ne 1 ]; then
        exit 2
    fi
    if ! printf '%s\n' "$output" | grep -q 'not mergeable yet'; then
        exit 1
    fi
    if [ "$tries" -ge "$retries" ]; then
        echo "pull request #$pr still cannot be merged after $retries retries" >&2
        exit 1
    fi
    tries=$((tries + 1))
    echo "pull request #$pr could not be merged yet; retry $tries of $retries in $delay seconds" >&2
    sleep "$delay"
done
